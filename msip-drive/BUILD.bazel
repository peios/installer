load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//build:musl.bzl", "musl_artifact", "musl_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "BUILD.bazel",
])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "out/**",
            "**/__pycache__/**",
            "**/*.pyc",
            "**/.ruff_cache/**",
            "**/node_modules/**",
        ],
    ),
)

rust_binary(
    name = "program",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["Cargo.toml"],
    crate_name = "program",
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    tags = ["manual"],
    version = VERSION,
    deps = [] + all_crate_deps(normal = True),
)

musl_artifact(
    name = "msip-drive",
    binary = ":program",
)

rust_test(
    name = "tests",
    size = "small",
    crate = ":program",
    deps = all_crate_deps(normal_dev = True),
)

musl_test(
    name = "musl-tests",
    size = "small",
    binary = ":tests",
)
