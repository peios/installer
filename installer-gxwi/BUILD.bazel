load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//build:checks.bzl", "shared_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "BUILD.bazel",
])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "target/**",
            "out/**",
            "**/__pycache__/**",
            "**/*.pyc",
            "**/.ruff_cache/**",
            "**/node_modules/**",
        ],
    ),
)

rust_library(
    name = "library",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["page/**"]) + ["Cargo.toml"],
    crate_name = "installer_gxwi",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = VERSION,
    deps = [] + all_crate_deps(normal = True),
)

rust_binary(
    name = "installer-gxwi",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["page/**"]) + ["Cargo.toml"],
    crate_name = "installer_gxwi",
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = VERSION,
    deps = [":library"] + all_crate_deps(normal = True),
)

rust_binary(
    name = "oobe-gxwi",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["page/**"]) + ["Cargo.toml"],
    crate_name = "oobe_gxwi",
    crate_root = "src/bin/oobe-gxwi.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = VERSION,
    deps = [":library"] + all_crate_deps(normal = True),
)

rust_test(
    name = "test-binary",
    size = "small",
    crate = ":library",
    data = glob(["page/**"]),
    rustc_env = {"CARGO_MANIFEST_DIR": "installer-gxwi"},
    tags = ["manual"],
    deps = all_crate_deps(normal_dev = True),
)

shared_test(
    name = "tests",
    size = "small",
    binary = ":test-binary",
    libraries = ["@peios_sdk//:library"],
)

filegroup(
    name = "package-data",
    srcs = glob([
        "registry.d/*.reg",
        "page/fonts/*.LICENSE",
    ]),
)
