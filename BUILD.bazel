load("//build:checks.bzl", "host_test")
load("//packages:package.bzl", "package_store")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
    "Cargo.lock",
])

filegroup(
    name = "artifacts",
    srcs = [
        "//install-tui",
        "//installer-gxwi",
        "//installer-gxwi:oobe-gxwi",
        "//installerd",
        "//msip-drive",
        "//oobe-tui",
        "//oobed",
    ],
)

filegroup(
    name = "rust-sources",
    srcs = [
        "//install-tui:sources",
        "//installer-gxwi:sources",
        "//installerd:sources",
        "//msip-drive:sources",
        "//msip-serve:sources",
        "//msip-tui:sources",
        "//oobe-tui:sources",
        "//oobed:sources",
    ],
)

filegroup(
    name = "build-files",
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
        "//build:BUILD.bazel",
        "//build:starlark",
        "//packages:build-files",
        "//tools:BUILD.bazel",
        "//vendor/ppk:BUILD.bazel",
    ] + [
        "//install-tui:BUILD.bazel",
        "//installer-gxwi:BUILD.bazel",
        "//installerd:BUILD.bazel",
        "//msip-drive:BUILD.bazel",
        "//msip-serve:BUILD.bazel",
        "//msip-tui:BUILD.bazel",
        "//oobe-tui:BUILD.bazel",
        "//oobed:BUILD.bazel",
    ],
)

genrule(
    name = "build-format-check",
    srcs = [":build-files"],
    outs = ["build-format-check.stamp"],
    cmd = "$(execpath @buildifier//file) -mode=check -lint=warn $(execpaths :build-files) && touch $@",
    tools = ["@buildifier//file"],
)

host_test(
    name = "vendor-test",
    size = "small",
    command = "exec python3 tools/test-bazel-vendor.py",
    data = [
        "//tools:bazel-vendor.py",
        "//tools:test-bazel-vendor.py",
    ],
    tags = [
        "external",
        "no-remote",
    ],
)

filegroup(
    name = "package-data",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
        "LICENSE",
        "//packages:definitions",
    ] + [
        "//install-tui:Cargo.toml",
        "//installer-gxwi:Cargo.toml",
        "//installerd:Cargo.toml",
        "//msip-drive:Cargo.toml",
        "//msip-serve:Cargo.toml",
        "//msip-tui:Cargo.toml",
        "//oobe-tui:Cargo.toml",
        "//oobed:Cargo.toml",
    ] + glob([
        "docs/man/*",
        "registry.d/*.reg",
        "third-party/*",
    ]) + ["//installer-gxwi:package-data"],
)

filegroup(
    name = "package-sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/.*/**",
            "**/.*",
            "bazel-*",
            "bazel-*/**",
            "target/**",
            "out/**",
            ".ci-sdk/**",
            "**/__pycache__/**",
            "**/*.pyc",
            "**/node_modules/**",
            "docs/learn/dist/**",
            "pekit.toml",
            "packages.pekit/**",
            "packaging/**",
        ],
    ) + glob(
        [".github/**"],
        allow_empty = True,
    ) + [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        ".cargo/config.toml",
        ".gitattributes",
        ".gitignore",
        ":package-data",
        ":rust-sources",
        "//build:sources",
        "//packages:sources",
        "//tools:sources",
        "//vendor/ppk:sources",
    ],
)

package_store(
    name = "packages",
    packages = ["//packages:all"],
)

host_test(
    name = "browser-harness-test",
    size = "small",
    command = "node --experimental-vm-modules --test installer-gxwi/dev/harness-tests.mjs installer-gxwi/dev/browser/cdp-tests.mjs installer-gxwi/dev/browser/chrome-tests.mjs installer-gxwi/dev/browser/exit-status-tests.mjs installer-gxwi/dev/browser/ending-state.mjs",
    data = ["//installer-gxwi:sources"],
    tags = [
        "external",
        "no-remote",
    ],
    target_compatible_with = select({
        "//build:native": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

host_test(
    name = "reproducibility-test",
    size = "small",
    command = "exec python3 tools/test-reproducibility.py",
    data = [
        "//tools:check-reproducibility.py",
        "//tools:test-reproducibility.py",
    ],
)
